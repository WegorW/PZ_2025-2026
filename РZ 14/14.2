import tkinter as tk

def find_middle_number():

    try:

        a = int(entry_a.get())
        b = int(entry_b.get())
        c = int(entry_c.get())

        if b < a < c or c < a < b:
            result = a
        elif a < b < c or c < b < a:
            result = b
        elif a < c < b or b < c < a:
            result = c
        else:
            result = "Среднее число не найдено"

        lbl_result.config(text=f"Среднее число: {result}", fg="#2e7d32")

    except ValueError:

        lbl_result.config(text="Ошибка: введите целые числа!", fg="#c62828")

root = tk.Tk()
root.title("ПЗ №14: Поиск среднего числа")
root.geometry("340x260")
root.resizable(False, False)

lbl_a = tk.Label(root, text="Число A:", font=("Arial", 10))
lbl_a.grid(row=0, column=0, padx=15, pady=10, sticky="e")
entry_a = tk.Entry(root, width=12, font=("Arial", 10))
entry_a.grid(row=0, column=1, padx=15, pady=10)

lbl_b = tk.Label(root, text="Число B:", font=("Arial", 10))
lbl_b.grid(row=1, column=0, padx=15, pady=5, sticky="e")
entry_b = tk.Entry(root, width=12, font=("Arial", 10))
entry_b.grid(row=1, column=1, padx=15, pady=5)

lbl_c = tk.Label(root, text="Число C:", font=("Arial", 10))
lbl_c.grid(row=2, column=0, padx=15, pady=5, sticky="e")
entry_c = tk.Entry(root, width=12, font=("Arial", 10))
entry_c.grid(row=2, column=1, padx=15, pady=5)

btn_calc = tk.Button(
    root,
    text="Найти среднее",
    command=find_middle_number,
    font=("Arial", 10, "bold"),
    bg="#1976d2",
    fg="white",
    activebackground="#1565c0"
)
btn_calc.grid(row=3, column=0, columnspan=2, pady=20, sticky="nsew")

lbl_result = tk.Label(
    root,
    text="Результат появится здесь",
    font=("Arial", 10),
    fg="#424242"
)
lbl_result.grid(row=4, column=0, columnspan=2, pady=5)

root.mainloop()
