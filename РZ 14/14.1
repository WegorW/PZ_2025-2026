import tkinter as tk
from tkinter import ttk, messagebox

class RegistrationForm:
    def __init__(self, root):
        self.root = root
        self.root.title("Регистрационная форма")
        self.root.geometry("500x600")
        self.root.configure(bg='#f0f0f0')

        main_frame = tk.Frame(root, bg='white', padx=20, pady=20)
        main_frame.pack(fill=tk.BOTH, expand=True, padx=20, pady=20)

        tk.Label(main_frame, text="Форма регистрации", font=("Arial", 20, "bold"),
                 bg='white', fg='#333').pack(pady=(0, 20))

        self.name_entry = self.create_field(main_frame, "Имя:")
        self.email_entry = self.create_field(main_frame, "Email:")
        self.phone_entry = self.create_field(main_frame, "Телефон:")

        subject_frame = tk.Frame(main_frame, bg='white')
        subject_frame.pack(fill=tk.X, pady=5)
        tk.Label(subject_frame, text="Subject:", font=("Arial", 10),
                 bg='white', anchor='w').pack(anchor='w')
        self.subject_combo = ttk.Combobox(subject_frame,
                                          values=["Выберите тему", "Общий запрос", "Поддержка", "Обратная связь", "Другое"],
                                          state="readonly", font=("Arial", 11))
        self.subject_combo.current(0)
        self.subject_combo.pack(fill=tk.X, pady=(5, 0))

        message_frame = tk.Frame(main_frame, bg='white')
        message_frame.pack(fill=tk.BOTH, expand=True, pady=5)
        tk.Label(message_frame, text="Message:", font=("Arial", 10),
                 bg='white', anchor='w').pack(anchor='w')
        self.message_text = tk.Text(message_frame, font=("Arial", 11),
                                    bg='#f9f9f9', relief=tk.SOLID, borderwidth=1, height=6)
        self.message_text.pack(fill=tk.BOTH, expand=True, pady=(5, 0))

        btn_frame = tk.Frame(main_frame, bg='white')
        btn_frame.pack(fill=tk.X, pady=(15, 0))
        tk.Button(btn_frame, text="Отправить", font=("Arial", 12, "bold"),
                  bg='#4CAF50', fg='white', relief=tk.FLAT, padx=20, pady=8,
                  cursor='hand2', command=self.submit).pack(side=tk.LEFT, padx=(0, 10))
        tk.Button(btn_frame, text="Сброс", font=("Arial", 12),
                  bg='#f44336', fg='white', relief=tk.FLAT, padx=20, pady=8,
                  cursor='hand2', command=self.reset).pack(side=tk.LEFT)

    def create_field(self, parent, label_text):
        frame = tk.Frame(parent, bg='white')
        frame.pack(fill=tk.X, pady=5)
        tk.Label(frame, text=label_text, font=("Arial", 10),
                 bg='white', anchor='w').pack(anchor='w')
        entry = tk.Entry(frame, font=("Arial", 11), bg='#f9f9f9',
                         relief=tk.SOLID, borderwidth=1)
        entry.pack(fill=tk.X, pady=(5, 0))
        return entry

    def submit(self):
        name = self.name_entry.get().strip()
        email = self.email_entry.get().strip()
        phone = self.phone_entry.get().strip()
        subject = self.subject_combo.get()
        message = self.message_text.get("1.0", tk.END).strip()

        if not name or not email or subject == "Выберите тему":
            messagebox.showerror("Ошибка", "Пожалуйста, заполните все обязательные поля!")
            return

        messagebox.showinfo("Успех",
                            f"Регистрация прошла успешно!\n\nИмя: {name}\nЭлектронная почта: {email}\nТелефон: {phone}\nТема: {subject}")

    def reset(self):
        self.name_entry.delete(0, tk.END)
        self.email_entry.delete(0, tk.END)
        self.phone_entry.delete(0, tk.END)
        self.subject_combo.current(0)
        self.message_text.delete("1.0", tk.END)

root = tk.Tk()
app = RegistrationForm(root)
root.mainloop()


